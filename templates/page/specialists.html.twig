{% extends 'base.html.twig' %}

{% block title %}{{ 'specialists.title'|trans }} - Medical{% endblock %}

{% block body_class %}sub_page{% endblock %}

{% block content %}
<section class="layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>{{ 'specialists.title'|trans }}</h2>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message|trans }}
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        {% endfor %}

        {% if errors is defined and errors|length > 0 %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        {% endif %}

        {% if specialists|length == 0 %}
            <p class="text-muted">{{ 'specialists.none'|trans }}</p>
        {% else %}
            <div class="row specialists-list">
                {% for specialist in specialists %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="specialist-card">
                        {% if specialist.photo %}
                            <img src="{{ asset('images/specialists/' ~ specialist.photo) }}" alt="{{ specialist.name }}" class="specialist-photo">
                        {% else %}
                            <div class="specialist-photo-placeholder"><i class="fa fa-user-md"></i></div>
                        {% endif %}
                        <div class="specialist-body">
                            <h5 class="specialist-name">{{ specialist.name }}</h5>
                            <p class="specialist-specialty">
                                {{ app.request.locale == 'bg' ? specialist.specialtyBg : specialist.specialtyEn }}
                            </p>
                            {% set bio = app.request.locale == 'bg' ? specialist.bioBg : specialist.bioEn %}
                            {% if bio %}
                                <p class="specialist-bio">{{ bio }}</p>
                            {% endif %}
                            <button class="btn1 btn-ask-question"
                                    data-toggle="modal"
                                    data-target="#askQuestionModal"
                                    data-specialist-id="{{ specialist.id }}"
                                    data-specialist-name="{{ specialist.name }}">
                                {{ 'specialists.ask'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="specialist-general-cta mt-4">
            <p>{{ 'specialists.general_hint'|trans }}</p>
            <button class="btn1 btn-ask-question"
                    data-toggle="modal"
                    data-target="#askQuestionModal"
                    data-specialist-id=""
                    data-specialist-name="">
                {{ 'specialists.ask_general'|trans }}
            </button>
        </div>
    </div>
</section>

<!-- Ask Question Modal -->
<div class="modal fade" id="askQuestionModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'specialists.form.title'|trans }}</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form action="{{ path('app_specialists') }}" method="post">
                <div class="modal-body">
                    <div class="form-group">
                        <label>{{ 'specialists.form.to'|trans }}</label>
                        <select class="form-control" name="specialist_id" id="modal-specialist-id">
                            <option value="">{{ 'specialists.form.general'|trans }}</option>
                            {% for specialist in specialists %}
                                <option value="{{ specialist.id }}">{{ specialist.name }}{% if app.request.locale == 'bg' and specialist.specialtyBg %} — {{ specialist.specialtyBg }}{% elseif specialist.specialtyEn %} — {{ specialist.specialtyEn }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <input type="text" class="form-control" name="name" placeholder="{{ 'contact.name'|trans }}" required>
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-control" name="email" placeholder="{{ 'contact.email'|trans }}" required>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-control" name="phone" placeholder="{{ 'contact.phone'|trans }}">
                    </div>
                    <div class="form-group">
                        <textarea class="form-control" name="question" rows="5"
                                  placeholder="{{ 'specialists.form.question'|trans }}" required></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="isAnonymous" name="is_anonymous" value="1">
                        <label class="form-check-label" for="isAnonymous">{{ 'specialists.form.anonymous'|trans }}</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn1">{{ 'specialists.form.submit'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
